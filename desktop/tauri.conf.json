{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiesler Desktop",
  "version": "0.1.1",
  "identifier": "com.wiesler.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "publisher": "Wiesler Local Demo",
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
