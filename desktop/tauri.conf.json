{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiesler",
  "version": "0.1.0",
  "identifier": "com.wiesler.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
